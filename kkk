task.spawn(function()
    while true do
        if not farmEnabled then
            task.wait(0.2)
            continue
        end

        local hrp = GetHRP()
        if not hrp then
            task.wait(0.5)
            continue
        end

        -- 1. สแกนหามอนสเตอร์ที่ยังมีชีวิต
        local enemies = GetAllLivingEnemies()
        if #enemies == 0 then
            -- ถ้าแมพยังไม่มีมอนเกิด รอแป๊บเดียวแล้วหาใหม่
            task.wait(0.5)
            continue
        end

        -- 2. เลือกมอนตัวที่ใกล้ที่สุด
        local target = FindNearestEnemy(enemies)
        if not target then
            task.wait(0.3)
            continue
        end

        Log(string.format("🎯 ล็อคเป้า: [%s] (HP: %s) — กำลังเคลื่อนเข้าไปโจมตี!", tostring(target.Name), tostring(math.floor(target.Health))))

        -- 3. เคลื่อนตามเป้าหมายแบบนุ่มนวลและโจมตีเป็นจังหวะจนกว่ามอนจะตาย
        local lastAttackAt = 0
        while farmEnabled do
            local currentHRP = GetHRP()
            if not currentHRP then break end

            -- ตรวจสอบว่าเป้าหมายยังอยู่และยังมีชีวิตอยู่หรือไม่
            local isAlive = false
            local latestCF = nil

            -- เช็คจาก Wrapper
            if target.Wrapper and target.Wrapper.Data and target.Wrapper.Data.Health then
                local hp = target.Wrapper.Data.Health.Value
                local isDied = target.Wrapper.Instance and target.Wrapper.Instance:GetAttribute("Died") == true
                if hp > 0 and not isDied then
                    isAlive = true
                    if target.Wrapper.HRP then
                        latestCF = target.Wrapper.HRP.CFrame
                    elseif target.Wrapper.Data.CurrentPosition then
                        latestCF = target.Wrapper.Data.CurrentPosition.Value
                    end
                end
            -- เช็คจาก Instance BasePart / Model
            elseif target.Instance and target.Instance.Parent then
                local data = target.Instance:FindFirstChild("Data")
                local hpVal = data and data:FindFirstChild("Health")
                local isDied = target.Instance:GetAttribute("Died") == true
                local hum = target.Instance:FindFirstChildWhichIsA("Humanoid")
                local hasHealth = hpVal ~= nil or hum ~= nil

                -- ถ้าอ่านค่า HP ไม่ได้แต่เป้ายังอยู่ ให้ตีต่อแทนการสลับเป้าก่อนเวลา
                if not isDied and ((hpVal and hpVal.Value > 0) or (hum and hum.Health > 0) or not hasHealth) then
                    isAlive = true
                    latestCF = target.Instance:IsA("BasePart") and target.Instance.CFrame or target.Instance:GetPivot()
                end
            end

            -- เปลี่ยนเป้าหมายเมื่อยืนยันว่าตายแล้ว หรือ Instance ถูกนำออกจากเกมเท่านั้น
            if not isAlive then
                Log(string.format("💀 มอนสเตอร์ [%s] ตายหรือถูกนำออกแล้ว! วาปไปตัวต่อไป...", tostring(target.Name)))
                break
            end

            -- ขยับตามตำแหน่งมอนอย่างต่อเนื่อง แทนการวาร์ปซ้ำทุกครั้งที่โจมตี
            local targetPos = (latestCF or target.CFrame)
            local hoverPosition = (targetPos * CFrame.new(0, CFG.HeightOffset, CFG.DistanceOffset)).Position
            local desiredCF = CFrame.new(hoverPosition) * currentHRP.CFrame.Rotation
            local deltaTime = RunService.Heartbeat:Wait()
            if not farmEnabled then break end

            local blend = 1 - math.exp(-CFG.FollowSmoothness * deltaTime)

            currentHRP.CFrame = currentHRP.CFrame:Lerp(desiredCF, blend)
            currentHRP.AssemblyLinearVelocity = Vector3.zero
            currentHRP.AssemblyAngularVelocity = Vector3.zero

            -- คุมจังหวะโจมตีแยกจากการเคลื่อนที่ เพื่อให้การตามเป้าหมายลื่นไหล
            local now = os.clock()
            if now - lastAttackAt >= CFG.AttackSpeed then
                Attack(target)
                lastAttackAt = now
            end
        end

        if farmEnabled then
            -- หน่วงเวลาจิ๊บจ๊อยก่อนวาปไปตัวต่อไปเพื่อความลื่นไหล
            task.wait(0.05)
        end
    end
end)
